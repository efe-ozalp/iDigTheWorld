# Copy this file to .env.local and fill it in. .env.local is git-ignored.
#
# Everything here is read only on the server (the /api handlers). Nothing has a
# VITE_ prefix, so Vite never bundles any of it into the browser code.
#
# On Databricks Apps you do not need this file: the platform sets
# DATABRICKS_HOST and the app's service principal credentials, and app.yaml
# sets the rest.

# ---------- AI provider ----------

# Which service writes the topic cards: "databricks" (default) or "anthropic".
AI_PROVIDER=databricks

# ---------- Databricks Foundation Model API (AI_PROVIDER=databricks) ----------

# Your workspace URL, for example https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=

# A personal access token, for local development only. On Databricks Apps the
# app's service principal is used instead.
DATABRICKS_TOKEN=

# Serving endpoint name. Defaults to databricks-llama-4-maverick when unset.
DATABRICKS_MODEL_ENDPOINT=databricks-llama-4-maverick

# ---------- Anthropic API (AI_PROVIDER=anthropic) ----------

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# The model is read only from here; the code has no fallback. claude-sonnet-5-5
# is the step up if the cards feel thin.
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- Geocoding ----------

# Contact address sent in the User-Agent of requests to Nominatim
# (OpenStreetMap asks apps to identify themselves).
NOMINATIM_CONTACT=
