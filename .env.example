# Copy this file to .env.local and fill it in. .env.local is git-ignored.
#
# These are read only by the serverless functions in /api. They have no VITE_
# prefix on purpose, so Vite never bundles them into the browser code.

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Model used to write the topic cards. Read from here only; nothing in the code
# falls back to a hardcoded model. claude-sonnet-5-5 is the step up if the
# cards feel thin.
ANTHROPIC_MODEL=claude-haiku-5-5
